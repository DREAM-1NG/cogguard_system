{
  "name": "cogguard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "CogGuard 前端 - 基于 Vue 3 + Ant Design Vue 的智能联合防御系统管理界面",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.spec.mjs",
    "build": "vue-tsc -b && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && node scripts/verify-build.mjs",
    "asset:map": "node scripts/simplify-world-map.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "3d-force-graph": "^1.80.0",
    "ant-design-vue": "^4.2.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "echarts": "^6.1.0",
    "pinia": "^2.3.0",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "less": "^4.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
