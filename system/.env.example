# CogGuard local and LAN prototype configuration.
# Copy this file to .env. Never commit populated secrets or API keys.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cogguard
MYSQL_PASSWORD=cogguard123
MYSQL_ROOT_PASSWORD=cogguard123
MYSQL_DATABASE=cogguard
MYSQL_DATABASE_TEST=cogguard_test

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=cogguard
MONGO_PASSWORD=cogguard123
MONGO_DATABASE=cogguard
MONGO_DATABASE_TEST=cogguard_test

# Redis and Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cogguard123
REDIS_DB=0

# Authentication
BACKEND_ENV=local
BACKEND_DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_PASSWORD=

# Optional authenticated demo warmup. Prefer setting these only in a local
# .env or the current PowerShell session; never commit populated credentials.
COGGUARD_DEMO_USERNAME=
COGGUARD_DEMO_PASSWORD=
COGGUARD_DEMO_EVENT_ID=trump_visit_2026_05_21

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Optional production static frontend profile
FRONTEND_PORT=5173
BACKEND_ORIGIN=http://host.docker.internal:8000

# Server-side media download guard
MEDIA_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false
MEDIA_DOWNLOAD_ROOT=./output/media_downloads

# Built-in social crawler runtime
MEDIACRAWLER_LOGIN_TYPE=cookie
MEDIACRAWLER_COOKIES=
MEDIACRAWLER_NODE_DIR=
MEDIACRAWLER_PROXY=
MEDIACRAWLER_GET_SUB_COMMENTS=false
MEDIACRAWLER_MAX_COMMENTS_PER_POST=200

# Coordination Discover runtime
COORDINATION_DISCOVER_MODE=artifact_first
COORDINATION_DISCOVER_ARTIFACT_ROOT=./artifacts/coordination_discover
COORDINATION_DISCOVER_DEVICE=cuda
COORDINATION_DISCOVER_FALLBACK=evidence_runtime_v2
COORDINATION_DISCOVER_DETECT_ROLE=validation_only
COORDINATION_DISCOVER_MODALITY_POLICY=platform_generic_only
COORDINATION_DISCOVER_REQUIRE_LEIDEN=true
MODEL_ARTIFACT_ROOT=./artifacts
# `auto` uses one accountable operator locally and two persisted approvals in production.
ANALYSIS_MODEL_ACTIVATION_APPROVAL_MODE=auto
# `auto` allows inline fallback locally and requires a durable Celery queue in production.
ANALYSIS_TEACHER_DISPATCH_MODE=auto
# Versioned query projections. Redis shares warm results across backend workers;
# setting REDIS_ENABLED=false keeps the process-local LRU only.
ANALYSIS_RESULT_CACHE_ENABLED=true
ANALYSIS_RESULT_CACHE_REDIS_ENABLED=true
ANALYSIS_RESULT_CACHE_MAX_ENTRIES=16
ANALYSIS_RESULT_CACHE_TTL_SECONDS=604800
ANALYSIS_RESULT_CACHE_NAMESPACE=cogguard:analysis-result

# Account detection runtime. No historical checkpoint is selected by default.
# Formal benchmark evidence uses TwiBot-20 plus independently reported public
# Cresci/Midterm adaptations. A governed Chinese bundle is required for online
# account detection.
BOTRHG_CHECKPOINT_PATH=
BOTRHG_DATA_FINGERPRINT=
BOTRHG_DEVICE=cpu
ACCOUNT_ACQUISITION_TEXT_MODEL_PATH=
ACCOUNT_ACQUISITION_MAX_LENGTH=128
ACCOUNT_ACQUISITION_BATCH_SIZE=4
ACCOUNT_ACQUISITION_DEVICE=cpu
# Governed account-model training policy. `MAX_RESUMES` excludes the initial run.
ACCOUNT_TRAINING_DAPT_TOKEN_THRESHOLD=500000
ACCOUNT_TRAINING_SUPERVISED_LABEL_THRESHOLD=200
ACCOUNT_TRAINING_COOLDOWN_DAYS=7
ACCOUNT_TRAINING_HEARTBEAT_TIMEOUT_SECONDS=300
ACCOUNT_TRAINING_MAX_RESUMES=3
# FastAPI publishes committed account-training intents from MySQL at this
# interval. Broker failures remain pending and retry after the same delay.
ACCOUNT_TRAINING_OUTBOX_POLL_INTERVAL_SECONDS=5
ACCOUNT_TRAINING_OUTBOX_CLAIM_LEASE_SECONDS=30
ACCOUNT_TRAINING_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
# Production: supply a distinct, at-least-32-character evaluator secret through
# the deployment secret store. Do not reuse JWT, database, or provider keys.
ACCOUNT_MODEL_EVALUATION_HMAC_SECRET=
# Production must remain disabled and start only with a governed MySQL Active
# Pointer. `local_legacy` is restricted to explicit non-production bootstrap.
ACCOUNT_MODEL_BOOTSTRAP_MODE=disabled

# Review model provider
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-5.4
LLM_API_WIRE=responses
LLM_TIMEOUT_SECONDS=180
LLM_INCLUDE_MEDIA_BASE64=false
LLM_REQUIRE_VISION=false
LLM_CACHE_MODE=off
LLM_CACHE_ROOT=./output/llm_cache

# Optional evidence retrieval provider
REVIEW_EXTERNAL_RETRIEVAL_ENABLED=false
REVIEW_RETRIEVAL_PROVIDER_NAME=
REVIEW_RETRIEVAL_API_KEY=
REVIEW_RETRIEVAL_BASE_URL=
REVIEW_RETRIEVAL_SEARCH_PATH=/search
REVIEW_RETRIEVAL_ADAPTER=
REVIEW_CONFIG_ENCRYPTION_KEY=
