# =============================================================================
# CogGuard 鐜鍙橀噺閰嶇疆
#
# 浣跨敤鏂瑰紡锛氬鍒舵湰鏂囦欢涓?.env锛岀劧鍚庢寜闇€淇敼鍊?
#   cp .env.example .env
#
# 娉ㄦ剰锛?env 鏂囦欢涓嶅簲鎻愪氦鍒扮増鏈帶鍒讹紙宸插湪 .gitignore 涓帓闄わ級
# =============================================================================

# ----- MySQL -----
# 缁撴瀯鍖栨暟鎹瓨鍌紙鐢ㄦ埛銆佷换鍔°€佸憡璀︾瓑锛?
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cogguard
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cogguard
MYSQL_DATABASE_TEST=cogguard_test

# ----- MongoDB -----
# 闈炵粨鏋勫寲鏁版嵁瀛樺偍锛堝笘瀛愩€佽瘎璁恒€佺埇鍙栧師濮嬫暟鎹瓑锛?
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=cogguard
MONGO_PASSWORD=
MONGO_DATABASE=cogguard
MONGO_DATABASE_TEST=cogguard_test

# ----- Redis -----
# 缂撳瓨銆佷細璇濈鐞嗐€丆elery 娑堟伅闃熷垪
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- JWT -----
# Token 璁よ瘉閰嶇疆锛岀敓浜х幆澧冨姟蹇呮洿鎹?SECRET_KEY
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=local
BACKEND_DEBUG=false
DEFAULT_ADMIN_PASSWORD=
PREVIEW_AUTH_ENABLED=false
PREVIEW_AUTH_TOKEN=
# 鍏佽璺ㄥ煙鐨勫墠绔湴鍧€鍒楄〃
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000

# ----- 鍐呯疆 crawler runtime锛堝彲閫夛級-----
# MEDIACRAWLER_LOGIN_TYPE=cookie
# MEDIACRAWLER_COOKIES=
# MEDIACRAWLER_NODE_DIR=D:/node
# MEDIACRAWLER_PROXY=http://127.0.0.1:7897
# MEDIACRAWLER_GET_SUB_COMMENTS=true
# MEDIACRAWLER_MAX_COMMENTS_PER_POST=200

# ----- REVIEW LLM / Agent Review锛堝彲閫夛級-----
# 浠呭湪浜哄伐瑙﹀彂 /risk/review/agent-reviews/run 鏃朵娇鐢紱/risk/assess 榛樿涓嶄細璋冪敤 LLM銆?
# 涓嶈鎶婄湡瀹?API Key 鍐欏叆 .env.example锛涜鍙啓鍏ユ湰鍦?.env銆?
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_WIRE=chat_completions
LLM_INCLUDE_MEDIA_BASE64=false
LLM_REQUIRE_VISION=false

# 澶栭儴涓诲姩妫€绱㈤粯璁ゅ叧闂紱褰撳墠瀹炵幇鏀寔鍙敞鍏?provider锛岄粯璁ゅ彧鍋氭湰鍦拌瘉鎹绱€?
REVIEW_EXTERNAL_RETRIEVAL_ENABLED=false

