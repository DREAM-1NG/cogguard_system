# =============================================================================
# CogGuard 环境变量配置
#
# 使用方式：复制本文件为 .env，然后按需修改值
#   cp .env.example .env
#
# 注意：.env 文件不应提交到版本控制（已在 .gitignore 中排除）
# =============================================================================

# ----- MySQL -----
# 结构化数据存储（用户、任务、告警等）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cogguard
MYSQL_PASSWORD=cogguard123
MYSQL_ROOT_PASSWORD=cogguard123
MYSQL_DATABASE=cogguard
MYSQL_DATABASE_TEST=cogguard_test

# ----- MongoDB -----
# 非结构化数据存储（帖子、评论、爬取原始数据等）
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=cogguard
MONGO_PASSWORD=cogguard123
MONGO_DATABASE=cogguard
MONGO_DATABASE_TEST=cogguard_test

# ----- Redis -----
# 缓存、会话管理、Celery 消息队列
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cogguard123
REDIS_DB=0

# ----- JWT -----
# 留空时本地开发会自动生成临时密钥（重启后会话失效）。
# 生产环境必须显式配置随机值，否则启动直接失败；
# well-known 占位值（如 change-me-...）会被拒绝，任何人都能用它伪造管理员 token。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
# 允许跨域的前端地址列表
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ----- 初始管理员 -----
# 首次启动且不存在 admin 账号时用于创建种子管理员；已存在的账号不会被覆写，
# 因此在数据库里改过密码后重启依然有效。生产环境留空会直接启动失败。
DEFAULT_ADMIN_PASSWORD=

# ----- 预览免登录（仅本地演示）-----
# 静态预览 token 可绕过认证，仅在 BACKEND_DEBUG=true 且 BACKEND_ENV=local 时生效。
# 默认关闭且 token 为空，避免部署环境接受一个众所周知的 bearer 值。
PREVIEW_AUTH_ENABLED=false
PREVIEW_AUTH_TOKEN=

# 服务端抓取媒体时只允许访问公网地址（防 SSRF）。
# 仅当本地 fixture 确实从 127.0.0.1 提供文件时才临时打开。
MEDIA_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false

# ----- Internal trained BotRHG account detection -----
# A verified checkpoint is required before the API leaves the deterministic fallback.
# BOTRHG_CHECKPOINT_PATH=./output/botrhg_weibo/checkpoint.pt
BOTRHG_DATA_FINGERPRINT=50327a90e7b9fa6cb65140af3e1573d139925033b184af2ed43aa938ab42c0ae
# BOTRHG_DEVICE=cpu

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000

# ----- 真实爬虫（可选）-----
# MediaCrawler 仓库根目录（绝对路径），用于 weibo / douyin / xhs 等
# MEDIACRAWLER_ROOT=D:/workspace/MediaCrawler
# MEDIACRAWLER_LOGIN_TYPE=cookie
# MEDIACRAWLER_COOKIES=
# MEDIACRAWLER_UV_BIN=uv
# MEDIACRAWLER_PYTHON_BIN=C:/Users/p/AppData/Roaming/uv/python/cpython-3.11-windows-x86_64-none/python.exe
# MEDIACRAWLER_NODE_DIR=D:/node
# MEDIACRAWLER_UV_CACHE_DIR=D:/workspace/MediaCrawler/.uv-cache
# MEDIACRAWLER_PROXY=http://127.0.0.1:7897
# MEDIACRAWLER_GET_SUB_COMMENTS=true
# MEDIACRAWLER_MAX_COMMENTS_PER_POST=200

# NewsCrawler 新闻提取：HTTP 方式（推荐，与 CogGuard 后端不同端口）
# NEWSCRAWLER_API_BASE=http://127.0.0.1:8020
# 或配置 NewsCrawler 仓库根目录，使用进程内 import（依赖其 Python 依赖）
# NEWSCRAWLER_ROOT=D:/workspace/NewsCrawler

# ----- Risk Review LLM / Agent Review（可选）-----
# 仅在人工触发 /risk/review/agent-reviews/run 时使用；/risk/assess 默认不会调用 LLM。
# 不要把真实 API Key 写入 .env.example；请只写入本地 .env。
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_WIRE=chat_completions
LLM_INCLUDE_MEDIA_BASE64=false
LLM_REQUIRE_VISION=false

# ----- LLM 响应回放缓存（演示稳定性）-----
# off    = 不缓存，每次都真实调用
# record = 真实调用后把成功响应落盘
# replay = 命中缓存直接回放，未命中则真实调用并落盘
# 缓存只写入真实成功响应，不存在手写内容；因此回放出来的一定是模型真实说过的话。
# 演示若开启 replay，需如实说明「演示采用预置缓存保证稳定性，系统支持实时调用」，
# 当前模式可通过 GET /api/v1/dashboard/llm-cache-status 查询。
LLM_CACHE_MODE=off

# 外部主动检索默认关闭；当前实现支持可注入 provider，默认只做本地证据检索。
REVIEW_EXTERNAL_RETRIEVAL_ENABLED=false
REVIEW_RETRIEVAL_API_KEY=
REVIEW_RETRIEVAL_BASE_URL=
REVIEW_RETRIEVAL_SEARCH_PATH=/search
