# =============================================================================
# CogGuard 环境变量配置
#
# 使用方式：复制本文件为 .env，然后按需修改值
#   cp .env.example .env
#
# 注意：.env 文件不应提交到版本控制（已在 .gitignore 中排除）
# =============================================================================

# ----- MySQL -----
# 结构化数据存储（用户、任务、告警等）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cogguard
MYSQL_PASSWORD=cogguard123
MYSQL_ROOT_PASSWORD=cogguard123
MYSQL_DATABASE=cogguard
MYSQL_DATABASE_TEST=cogguard_test

# ----- MongoDB -----
# 非结构化数据存储（帖子、评论、爬取原始数据等）
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=cogguard
MONGO_PASSWORD=cogguard123
MONGO_DATABASE=cogguard
MONGO_DATABASE_TEST=cogguard_test

# ----- Redis -----
# 缓存、会话管理、Celery 消息队列
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cogguard123
REDIS_DB=0

# ----- JWT -----
# Token 认证配置，生产环境务必更换 SECRET_KEY
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
# 允许跨域的前端地址列表
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000

# ----- 真实爬虫（可选）-----
# MediaCrawler 仓库根目录（绝对路径），用于 weibo / douyin / xhs 等
# MEDIACRAWLER_ROOT=D:/workspace/MediaCrawler
# MEDIACRAWLER_LOGIN_TYPE=cookie
# MEDIACRAWLER_COOKIES=
# MEDIACRAWLER_UV_BIN=uv
# MEDIACRAWLER_PYTHON_BIN=C:/Users/p/AppData/Roaming/uv/python/cpython-3.11-windows-x86_64-none/python.exe
# MEDIACRAWLER_NODE_DIR=D:/node
# MEDIACRAWLER_UV_CACHE_DIR=D:/workspace/MediaCrawler/.uv-cache
# MEDIACRAWLER_PROXY=http://127.0.0.1:7897
# MEDIACRAWLER_GET_SUB_COMMENTS=true
# MEDIACRAWLER_MAX_COMMENTS_PER_POST=200

# NewsCrawler 新闻提取：HTTP 方式（推荐，与 CogGuard 后端不同端口）
# NEWSCRAWLER_API_BASE=http://127.0.0.1:8020
# 或配置 NewsCrawler 仓库根目录，使用进程内 import（依赖其 Python 依赖）
# NEWSCRAWLER_ROOT=D:/workspace/NewsCrawler

# ----- KT3 LLM / Agent Review（可选）-----
# 仅在人工触发 /risk/kt3/agent-reviews/run 时使用；/risk/assess 默认不会调用 LLM。
# 不要把真实 API Key 写入 .env.example；请只写入本地 .env。
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_WIRE=chat_completions
LLM_INCLUDE_MEDIA_BASE64=false
LLM_REQUIRE_VISION=false

# 外部主动检索默认关闭；当前实现支持可注入 provider，默认只做本地证据检索。
KT3_EXTERNAL_RETRIEVAL_ENABLED=false
