LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-5.4
LLM_API_WIRE=responses
LLM_INCLUDE_MEDIA_BASE64=false
MODEL_ARTIFACT_ROOT=./artifacts
# Governed account-model training policy. `MAX_RESUMES` excludes the initial run.
ACCOUNT_TRAINING_DAPT_TOKEN_THRESHOLD=500000
ACCOUNT_TRAINING_SUPERVISED_LABEL_THRESHOLD=200
ACCOUNT_TRAINING_COOLDOWN_DAYS=7
ACCOUNT_TRAINING_HEARTBEAT_TIMEOUT_SECONDS=300
ACCOUNT_TRAINING_MAX_RESUMES=3
# FastAPI publishes committed account-training intents from MySQL at this
# interval. Broker failures remain pending and retry after the same delay.
ACCOUNT_TRAINING_OUTBOX_POLL_INTERVAL_SECONDS=5
ACCOUNT_TRAINING_OUTBOX_CLAIM_LEASE_SECONDS=30
ACCOUNT_TRAINING_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
# Local-only evaluator secret. Production must source a distinct secret of at
# least 32 characters from its secret store instead of this example file.
ACCOUNT_MODEL_EVALUATION_HMAC_SECRET=
# This explicit local-only mode writes an unreviewed MySQL pointer from the
# legacy checkpoint. Production must use `disabled` and a governed pointer.
ACCOUNT_MODEL_BOOTSTRAP_MODE=local_legacy
# Use `auto` for local single-operator activation or production persisted dual approval.
ANALYSIS_MODEL_ACTIVATION_APPROVAL_MODE=auto
# Use `auto` for local inline fallback or production queue-required Teacher review.
ANALYSIS_TEACHER_DISPATCH_MODE=auto
# Versioned query projections; Redis is shared, local LRU remains the fast path.
ANALYSIS_RESULT_CACHE_ENABLED=true
ANALYSIS_RESULT_CACHE_REDIS_ENABLED=true
ANALYSIS_RESULT_CACHE_MAX_ENTRIES=16
ANALYSIS_RESULT_CACHE_TTL_SECONDS=604800
ANALYSIS_RESULT_CACHE_NAMESPACE=cogguard:analysis-result
LLM_REQUIRE_VISION=false

REVIEW_RETRIEVAL_PROVIDER_NAME=Exa
REVIEW_RETRIEVAL_API_KEY=
REVIEW_RETRIEVAL_BASE_URL=https://api.exa.ai
REVIEW_RETRIEVAL_SEARCH_PATH=/search
REVIEW_RETRIEVAL_ADAPTER=exa

REVIEW_CONFIG_ENCRYPTION_KEY=

